# Copy this file to .env.local and fill in your Supabase project details.
# Find these under Project Settings > API in your Supabase dashboard.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Note: automatic link previews use a Supabase Edge Function
# (supabase/functions/link-preview), not a third-party API — so no extra
# key or env var is needed for that. See the README for the one-time
# `supabase functions deploy link-preview` setup step.
